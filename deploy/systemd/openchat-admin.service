# OpenChat —— split 形态：管理层（HTTP API / RBAC / 审计装饰器 / 桥接代理）
#
# 只监听 127.0.0.1:7780，由 Caddy 对白名单 IP 反代 /api/admin/*。
# 自身不执行管理动作：所有指令经 bridgeproxy 翻译成 5xx 帧注入总线。
# ⚠️⚠️ 警告：split 形态二进制尚未构建（chatd 当前 embedded-only，见
# server/cmd/chatd/main.go）。本 unit 引用的 bin/chatd-admin 不存在，启用前
# 必须先实现 server/cmd/chatd-admin。在此之前请使用 openchat.service。

[Unit]
Description=OpenChat admin layer (HTTP API, RBAC, audit shim)
Documentation=https://github.com/yingo-server/OpenChat/blob/main/docs/deploy.md
After=network-online.target openchat-bridge.service
Wants=network-online.target
Requires=openchat-bridge.service

[Service]
Type=notify
NotifyAccess=main
User=openchat-admin
Group=openchat
RuntimeDirectory=openchat
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
SupplementaryGroups=openchat
WorkingDirectory=/etc/openchat

ExecStart=/opt/openchat/current/bin/chatd-admin --config /etc/openchat/openchat.toml
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
KillMode=mixed
TimeoutStartSec=30
TimeoutStopSec=30

Restart=always
RestartSec=1
WatchdogSec=15

LimitNOFILE=8192
LimitNPROC=2048
TasksMax=2048
EnvironmentFile=/etc/openchat/env.d/admin.env
Environment=TZ=UTC
Environment=LANG=C.UTF-8
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openchat-admin

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native

CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @obsolete

# admin.db（管理员账号/会话）独立于业务热库，按最小权限隔离
ReadWritePaths=/var/lib/openchat/admin /run/openchat
ReadOnlyPaths=/etc/openchat /opt/openchat
UMask=0077

[Install]
WantedBy=multi-user.target
