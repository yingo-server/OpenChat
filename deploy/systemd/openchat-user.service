# OpenChat —— split 形态：用户层网关（WS acceptor / codec / limiter / router）
#
# 唯一对外暴露的 WS 入口：Caddy /ws → 127.0.0.1:8081（本进程）。
# 不持有数据库，不落任何业务数据；只写 UDS 与缓存目录。

[Unit]
Description=OpenChat user gateway (WebSocket)
Documentation=https://github.com/yingo-server/OpenChat/blob/main/docs/deploy.md
After=network-online.target openchat-bridge.service
Wants=network-online.target
Requires=openchat-bridge.service

[Service]
Type=notify
NotifyAccess=main
User=openchat-user
Group=openchat
RuntimeDirectory=openchat
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
SupplementaryGroups=openchat
WorkingDirectory=/etc/openchat

ExecStart=/opt/openchat/current/bin/chatd-user --config /etc/openchat/openchat.toml
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
KillMode=mixed
TimeoutStartSec=30
TimeoutStopSec=30

Restart=always
RestartSec=1
WatchdogSec=15

LimitNOFILE=16384
LimitNPROC=4096
TasksMax=8192
EnvironmentFile=/etc/openchat/env.d/user.env
Environment=TZ=UTC
Environment=LANG=C.UTF-8
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openchat-user

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native

CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @obsolete

ReadWritePaths=/run/openchat /var/lib/openchat/user
ReadOnlyPaths=/etc/openchat /opt/openchat
UMask=0077

[Install]
WantedBy=multi-user.target
