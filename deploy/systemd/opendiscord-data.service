# OpenDiscord —— split 形态：数据层（写管道 / 读路由 / 归档 / 备份 / 策略装载）
#
# 唯一直接接触 SQLite 热库与媒体文件的进程。
# 冷库 Postgres 在外部，本机不监听任何公网端口。
# ⚠️⚠️ 警告：split 形态二进制尚未构建（chatd 当前 embedded-only，见
# server/cmd/chatd/main.go）。本 unit 引用的 bin/chatd-data 不存在，启用前
# 必须先实现 server/cmd/chatd-data。在此之前请使用 opendiscord.service。

[Unit]
Description=OpenDiscord data layer (SQLite hot store, archiver, backup)
Documentation=https://github.com/yingo-server/OpenDiscord/blob/main/docs/deploy.md
After=network-online.target opendiscord-bridge.service
Wants=network-online.target
Requires=opendiscord-bridge.service

[Service]
Type=notify
NotifyAccess=main
User=opendiscord-data
Group=opendiscord
RuntimeDirectory=opendiscord
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
SupplementaryGroups=opendiscord
WorkingDirectory=/etc/opendiscord

ExecStart=/opt/opendiscord/current/bin/chatd-data --config /etc/opendiscord/opendiscord.toml
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
KillMode=mixed
TimeoutStartSec=30
# 数据层 SIGTERM 需要把 flusher 缓冲最后一次组提交 + 归档断点落盘，预算 30s
TimeoutStopSec=30

Restart=always
RestartSec=1
WatchdogSec=15

LimitNOFILE=16384
LimitNPROC=4096
TasksMax=4096
EnvironmentFile=/etc/opendiscord/env.d/data.env
Environment=TZ=UTC
Environment=LANG=C.UTF-8
StandardOutput=journal
StandardError=journal
SyslogIdentifier=opendiscord-data

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native

CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @obsolete

# 热库 / 媒体 / 备份临时文件都在这里；媒体目录经 LUKS 卷挂载
ReadWritePaths=/var/lib/opendiscord/data /var/lib/opendiscord/media /var/lib/opendiscord/backup /run/opendiscord
ReadOnlyPaths=/etc/opendiscord /opt/opendiscord
UMask=0077

[Install]
WantedBy=multi-user.target
