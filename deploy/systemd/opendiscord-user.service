# OpenDiscord —— split 形态：用户层网关（WS acceptor / codec / limiter / router）
#
# 唯一对外暴露的 WS 入口：Caddy /ws → 127.0.0.1:8081（本进程）。
# 不持有数据库，不落任何业务数据；只写 UDS 与缓存目录。
# ⚠️⚠️ 警告：split 形态二进制尚未构建（chatd 当前 embedded-only，见
# server/cmd/chatd/main.go）。本 unit 引用的 bin/chatd-user 不存在，启用前
# 必须先实现 server/cmd/chatd-user。在此之前请使用 opendiscord.service。

[Unit]
Description=OpenDiscord user gateway (WebSocket)
Documentation=https://github.com/yingo-server/OpenDiscord/blob/main/docs/deploy.md
After=network-online.target opendiscord-bridge.service
Wants=network-online.target
Requires=opendiscord-bridge.service

[Service]
Type=notify
NotifyAccess=main
User=opendiscord-user
Group=opendiscord
RuntimeDirectory=opendiscord
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
SupplementaryGroups=opendiscord
WorkingDirectory=/etc/opendiscord

ExecStart=/opt/opendiscord/current/bin/chatd-user --config /etc/opendiscord/opendiscord.toml
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
KillMode=mixed
TimeoutStartSec=30
TimeoutStopSec=30

Restart=always
RestartSec=1
WatchdogSec=15

LimitNOFILE=16384
LimitNPROC=4096
TasksMax=8192
EnvironmentFile=/etc/opendiscord/env.d/user.env
Environment=TZ=UTC
Environment=LANG=C.UTF-8
StandardOutput=journal
StandardError=journal
SyslogIdentifier=opendiscord-user

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native

CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @obsolete

ReadWritePaths=/run/opendiscord /var/lib/opendiscord/user
ReadOnlyPaths=/etc/opendiscord /opt/opendiscord
UMask=0077

[Install]
WantedBy=multi-user.target
