# OpenChat —— split 形态：数据层（写管道 / 读路由 / 归档 / 备份 / 策略装载）
#
# 唯一直接接触 SQLite 热库与媒体文件的进程。
# 冷库 Postgres 在外部，本机不监听任何公网端口。

[Unit]
Description=OpenChat data layer (SQLite hot store, archiver, backup)
Documentation=https://github.com/yingo-server/OpenChat/blob/main/docs/deploy.md
After=network-online.target openchat-bridge.service
Wants=network-online.target
Requires=openchat-bridge.service

[Service]
Type=notify
NotifyAccess=main
User=openchat-data
Group=openchat
RuntimeDirectory=openchat
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
SupplementaryGroups=openchat
WorkingDirectory=/etc/openchat

ExecStart=/opt/openchat/current/bin/chatd-data --config /etc/openchat/openchat.toml
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
KillMode=mixed
TimeoutStartSec=30
# 数据层 SIGTERM 需要把 flusher 缓冲最后一次组提交 + 归档断点落盘，预算 30s
TimeoutStopSec=30

Restart=always
RestartSec=1
WatchdogSec=15

LimitNOFILE=16384
LimitNPROC=4096
TasksMax=4096
EnvironmentFile=/etc/openchat/env.d/data.env
Environment=TZ=UTC
Environment=LANG=C.UTF-8
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openchat-data

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native

CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @obsolete

# 热库 / 媒体 / 备份临时文件都在这里；媒体目录经 LUKS 卷挂载
ReadWritePaths=/var/lib/openchat/data /var/lib/openchat/media /var/lib/openchat/backup /run/openchat
ReadOnlyPaths=/etc/openchat /opt/openchat
UMask=0077

[Install]
WantedBy=multi-user.target
