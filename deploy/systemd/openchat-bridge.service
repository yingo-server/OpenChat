# OpenChat —— split 形态：桥接层（Bus + FrameRW + AdminAPI + Supervisor）
#
# split 部署时同代码编译出 5 个二进制，层间走 UDS；配置文件从
# /etc/openchat/openchat.toml 的 [mode] 段切换为 "split"。
#
# 与 embedded 相同的加固基线，差异只在 User / ReadWritePaths / RuntimeDirectory。
# ⚠️⚠️ 警告：split 形态二进制尚未构建（chatd 当前 embedded-only，见
# server/cmd/chatd/main.go）。本 unit 引用的 bin/chatd-bridge 不存在，启用前
# 必须先实现 server/cmd/chatd-bridge。在此之前请使用 openchat.service。

[Unit]
Description=OpenChat bridge layer (bus, frame router, admin API)
Documentation=https://github.com/yingo-server/OpenChat/blob/main/docs/deploy.md
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=openchat-bridge
Group=openchat
# 所有层共用 /run/openchat；组长 openchat，mode 0750
RuntimeDirectory=openchat
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
SupplementaryGroups=openchat
WorkingDirectory=/etc/openchat

ExecStart=/opt/openchat/current/bin/chatd-bridge --config /etc/openchat/openchat.toml
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
KillMode=mixed
TimeoutStartSec=30
TimeoutStopSec=30

Restart=always
RestartSec=1
WatchdogSec=15

LimitNOFILE=16384
LimitNPROC=4096
TasksMax=4096
EnvironmentFile=/etc/openchat/env.d/bridge.env
Environment=TZ=UTC
Environment=LANG=C.UTF-8
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openchat-bridge

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native

CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @obsolete

# 桥接层不落业务数据：只需要 UDS 目录与自己的运行目录
ReadWritePaths=/run/openchat /var/lib/openchat/bridge
ReadOnlyPaths=/etc/openchat /opt/openchat
UMask=0077

[Install]
WantedBy=multi-user.target
